HTTP_ADDRESS=:8080
DATABASE_URL=postgres://wallet:wallet_dev_only@localhost:5432/wallet?sslmode=disable
KAFKA_BROKERS=localhost:9092
RISK_POLICY_VERSION=risk-v1
